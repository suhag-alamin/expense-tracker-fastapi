# PostgreSQL password used inside DATABASE_URL
DB_PASS=your_database_password

# Full SQLAlchemy connection string for your PostgreSQL database
DATABASE_URL=postgresql://postgres:your_database_password@localhost:5432/expense_tracker

# Secret used to sign JWT access tokens
# Generate one with: openssl rand -hex 32
SECRET_KEY=replace_this_with_a_long_random_string

# Signing algorithm used by python-jose
ALGORITHM=HS256
